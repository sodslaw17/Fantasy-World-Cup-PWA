# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # NEVER expose to client

# ── Site URL (used in magic-link redirect) ───────────────────────────────────
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set on Vercel):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Role guards ───────────────────────────────────────────────────────────────
# Comma-separated emails. Case-insensitive.
ADMIN_EMAILS=organizer@example.com,another@example.com
SUPER_ADMIN_EMAILS=superuser@example.com

# ── Push notifications (Phase 7) ─────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:organizer@example.com
